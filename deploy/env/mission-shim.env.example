# mission-shim — copy to deploy/env/mission-shim.env. NEVER commit secrets.
# Device-side bridge: command topic -> signed rover mission file.

# Broker login MUST be the device account (ACL: reads only own command topic)
MQTT_URL=mqtt://device-rover-01:CHANGE_ME@127.0.0.1:1883

# MUST equal the rover's ROVER_MISSION_SECRET (HMAC mission signing key)
SHIM_SIGNING_SECRET=CHANGE_ME

# Inbox dir the rover watches (watch-missions). Shared volume/dir on the
# rover host in real deployments.
SHIM_INBOX_DIR=./mission-inbox

# Per-device shim config (JSON). routes maps module waypoint_id -> rover
# route_id ('*' = fallback); camera_id for capture_photo.
SHIM_DEVICES={"rover-01":{"camera_id":"cam-mast","routes":{"*":"patrol-main","wp-rack-a":"patrol-rack"},"mqtt_username":"device-rover-01","mqtt_password":"CHANGE_ME"}}

# SHIM_COMMAND_TOPIC=sentinel/v1/{device}/command   # default
