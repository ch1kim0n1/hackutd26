# containment-executor-service — copy to deploy/env/executor.env.
# Point gateway EXECUTOR_WEBHOOK_URL at http://<host>:8082/execute.

EXECUTOR_PORT=8082
EXECUTOR_TOKEN=CHANGE_ME            # must equal gateway EXECUTOR_WEBHOOK_TOKEN bearer
EXECUTOR_ACTION_TTL_S=300

# Lab honesty test hooks (leave unset in normal runs):
# EXECUTOR_FAIL_APPLY=1             # adapter apply always errors
# EXECUTOR_LIE_ABOUT_SUCCESS=1      # API acks but isolation never happens -> FAILED
