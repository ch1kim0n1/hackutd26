# Copy to deploy/env/gateway.env — bootstrap.sh auto-fills the empty
# secrets below from deploy/secrets/identities.json + env/mqtt.env.
# NEVER commit real values.

SPACETIMEDB_URI=ws://127.0.0.1:3000
SPACETIMEDB_DATABASE=sentinel-hive
# gateway-role identity token (from seed output)
SPACETIMEDB_TOKEN=
# executor-role identity token (optional; enables outbox worker)
EXECUTOR_SPACETIMEDB_TOKEN=

MQTT_URL=tcp://127.0.0.1:1883
MQTT_USERNAME=sentinel-gateway
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=sentinel/v1

EXECUTOR_WEBHOOK_URL=http://127.0.0.1:8082/execute
EXECUTOR_WEBHOOK_TOKEN=

GATEWAY_HEALTH_PORT=8081
GATEWAY_STATE_FILE=./gateway-state.json

# Per-device HMAC keys for signature-verified observations (sensors/pucks).
# JSON map device_id -> shared secret. Configured devices MUST present a
# valid HMAC-SHA256 signature over the canonical envelope.
# IMPORTANT: when sourcing with `set -a; . gateway.env; set +a`, wrap the
# JSON in SINGLE quotes — bash strips unquoted inner double quotes:
#   GATEWAY_DEVICE_HMAC_KEYS='{"puck-a-01":"<64-hex-secret>"}'
GATEWAY_DEVICE_HMAC_KEYS={}
