# Virtual data-center simulator publisher (#100/#101)
# MQTT uplink (omit MQTT_HOST for console transport)
MQTT_HOST=192.168.8.50
MQTT_PORT=1883
MQTT_USERNAME=device-datacenter-sim
MQTT_PASSWORD=
MQTT_CLIENT_ID=datacenter-sim
# Per-node HMAC secrets -> must match GATEWAY_DEVICE_HMAC_KEYS entries
# for vpi-compute-01, vpi-network-01, vpi-sensor-01, vpi-mgmt-01.
# Set via env JSON when running publisher (see publisher.py secrets map).
