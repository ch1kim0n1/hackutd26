# Phantom Command live adapters (issue #98)
# Copy to .env.local — never commit real tokens.

# SpacetimeDB gateway (docker compose -f deploy/compose.dev.yml up)
VITE_SPACETIMEDB_URI=http://127.0.0.1:3000
VITE_SPACETIMEDB_DATABASE=sentinel-hive
# Provisioned identity token for a role that can read ops feeds.
# Admin sees all incidents; observer/commander see role-scoped subsets.
# Tokens are generated by deploy/seeds/seed.ts → deploy/secrets/identities.json
VITE_SPACETIMEDB_TOKEN=

# Python API facade (issue #96): cd apps/api && uvicorn sentinel_api.app:app
VITE_API_BASE=http://127.0.0.1:8000
VITE_API_POLL_MS=5000

# 'fixture' replays recorded backend rows labelled REPLAY (tests/offline).
# 'real' (default) connects to SpacetimeDB + FastAPI. ?live=fixture overrides at runtime.
VITE_LIVE_TRANSPORT=real
